# Pick one provider. With none set, AgentForge runs its deterministic offline
# backend — the graph, retries, critic loop and evals all work without a key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional durable state. Falls back to in-memory when unset.
REDIS_URL=redis://localhost:6379/0
POSTGRES_URL=postgresql://localhost:5432/agentforge
